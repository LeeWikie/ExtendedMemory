{
	"name": "extended-memory",
	"version": "0.4.2",
	"description": "Resident Markdown memory for pi, organized asynchronously by a private background agent",
	"main": "index.ts",
	"type": "module",
	"keywords": [
		"pi",
		"pi-coding-agent",
		"pi-package",
		"memory",
		"resident-memory",
		"background-agent",
		"markdown"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"author": "jayzeng",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LeeWikie/ExtendedMemory.git"
	},
	"bugs": {
		"url": "https://github.com/LeeWikie/ExtendedMemory/issues"
	},
	"homepage": "https://github.com/LeeWikie/ExtendedMemory#readme",
	"files": [
		"index.ts",
		"background",
		"templates",
		"docs",
		"scripts",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"postinstall": "node scripts/postinstall.cjs",
		"build": "tsc -p tsconfig.json --noEmit",
		"lint": "biome check .",
		"test": "bun test test/unit.test.ts test/resident.test.ts && npm run test:background",
		"test:background": "node --experimental-strip-types test/memory-agent.test.mjs && node --experimental-strip-types test/memory-filesystem.test.mjs && node --experimental-strip-types test/background.test.mjs && node --experimental-strip-types test/background-lifecycle.test.mjs && node --experimental-strip-types test/recent.test.mjs",
		"test:e2e": "npx tsx test/e2e.ts",
		"test:eval": "bun test/eval-recall.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@earendil-works/pi-agent-core": "0.87.1",
		"@earendil-works/pi-ai": "0.87.1",
		"@earendil-works/pi-coding-agent": "0.87.1",
		"tsx": "^4.0.0",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"js-tiktoken": "1.0.21"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": ">=0.87.1",
		"@earendil-works/pi-ai": ">=0.87.1",
		"@earendil-works/pi-coding-agent": ">=0.87.1"
	},
	"overrides": {
		"rimraf": "^6.1.3",
		"glob": "^13.0.3"
	},
	"contributors": [
		"LeeWikie (ExtendedMemory)"
	]
}
